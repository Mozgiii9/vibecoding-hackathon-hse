# Copy outside Git to .runtime/agent-a.env and chmod 600 before filling secrets.
# One line per key; single-quote values containing dollar signs.
HACKATHON_OWNER=agent-a
HACKATHON_INSTANCE_ID=ryadom_a
# Full 40-character committed SHA containing this packaging.
HACKATHON_SOURCE_SHA=
HACKATHON_UI_PORT=15073
HACKATHON_GATEWAY_PORT=18787
# Only the no-Docker launcher uses these loopback MCP ports; preflight checks all.
HACKATHON_MCP_MEMORY_PORT=18911
HACKATHON_MCP_AUTH_PORT=18912
HACKATHON_MCP_PROJECT_PORT=18913
# Generate privately once with: openssl rand -base64 32
# Keep the same key for this instance across restart and rollback.
HACKATHON_SECRETS_MASTER_KEY_B64=
HACKATHON_LLM_PROTOCOL=openai-compatible
HACKATHON_LLM_BASE_URL=
HACKATHON_LLM_MODEL=
HACKATHON_LLM_API_KEY=
HACKATHON_LLM_TIMEOUT_MS=60000
HACKATHON_STT_BASE_URL=
HACKATHON_STT_MODEL=
HACKATHON_STT_API_KEY=
