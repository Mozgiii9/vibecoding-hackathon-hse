# syntax=docker/dockerfile:1.7
ARG NODE_IMAGE
ARG EDGE_IMAGE
FROM ${NODE_IMAGE} AS web-build
WORKDIR /src/app/builds/typescript/client_web
# npm's file:.. dependency needs its parent package even during npm ci.
COPY app/builds/typescript/package.json ../package.json
COPY app/builds/typescript/client_web/package.json app/builds/typescript/client_web/package-lock.json ./
RUN npm ci
# Preserve repository-relative imports of shared contracts and the demo fixture.
COPY app/builds/typescript/ /src/app/builds/typescript/
COPY docs/contracts/ /src/docs/contracts/
RUN npm run typecheck && npm run build

FROM ${EDGE_IMAGE}
ARG SOURCE_SHA
LABEL org.opencontainers.image.title="Рядом web" org.opencontainers.image.revision=${SOURCE_SHA}
COPY --from=web-build /src/app/builds/typescript/client_web/dist /usr/share/caddy
COPY app/installer/hackathon/Caddyfile /etc/caddy/Caddyfile
RUN printf '{"source_sha":"%s"}\n' "$SOURCE_SHA" > /usr/share/caddy/release.json
