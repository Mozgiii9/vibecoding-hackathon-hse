# syntax=docker/dockerfile:1.7
ARG NODE_IMAGE
FROM ${NODE_IMAGE} AS runtime-build
WORKDIR /src/builds/typescript
COPY builds/typescript/package.json builds/typescript/package-lock.json builds/typescript/tsconfig.json ./
RUN npm ci
COPY builds/typescript/ ./
RUN npm run build && npm prune --omit=dev

FROM ${NODE_IMAGE} AS mcp-build
WORKDIR /src/builds/mcp_release
COPY builds/mcp_release/package.json builds/mcp_release/package-lock.json builds/mcp_release/tsconfig.json ./
RUN npm ci
COPY builds/mcp_release/ ./
RUN npm run build && npm prune --omit=dev

FROM ${NODE_IMAGE}
ARG SOURCE_SHA
LABEL org.opencontainers.image.title="Рядом gateway and MCP" \
      org.opencontainers.image.revision=${SOURCE_SHA}
RUN apt-get update && apt-get install -y --no-install-recommends ca-certificates dumb-init git \
    && rm -rf /var/lib/apt/lists/* \
    && groupadd --gid 10001 ryadom && useradd --uid 10001 --gid 10001 --no-create-home ryadom
ENV NODE_ENV=production PAA_STARTER_PACK_DIR=/app/typescript/memory/starter-pack
COPY --from=runtime-build /src/builds/typescript/package*.json /app/typescript/
COPY --from=runtime-build /src/builds/typescript/node_modules /app/typescript/node_modules
COPY --from=runtime-build /src/builds/typescript/dist /app/typescript/dist
COPY --from=runtime-build /src/builds/typescript/config.json /app/typescript/config.json
COPY --from=runtime-build /src/builds/typescript/adapters /app/typescript/adapters
COPY --from=runtime-build /src/builds/typescript/mcp /app/typescript/mcp
COPY --from=runtime-build /src/builds/typescript/memory/starter-pack /app/typescript/memory/starter-pack
COPY --from=mcp-build /src/builds/mcp_release/package*.json /app/mcp_release/
COPY --from=mcp-build /src/builds/mcp_release/node_modules /app/mcp_release/node_modules
COPY --from=mcp-build /src/builds/mcp_release/dist /app/mcp_release/dist
COPY installer/hackathon/entrypoint.sh installer/hackathon/healthcheck.mjs /usr/local/lib/ryadom/
RUN chmod +x /usr/local/lib/ryadom/entrypoint.sh \
    && mkdir -p /data/memory /run/paa-secrets \
    && chown -R ryadom:ryadom /app /data/memory /run/paa-secrets
USER ryadom
WORKDIR /app/typescript
ENTRYPOINT ["/usr/bin/dumb-init", "--", "/usr/local/lib/ryadom/entrypoint.sh"]
