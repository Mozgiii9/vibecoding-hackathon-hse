# Copy to .env.hackathon locally. Never commit real credentials.
# Choose the protocol actually supported by your custom Gemini provider.
HACKATHON_LLM_PROTOCOL=
HACKATHON_LLM_BASE_URL=
HACKATHON_LLM_MODEL=
HACKATHON_LLM_API_KEY=
HACKATHON_LLM_TIMEOUT_MS=60000

# Optional, separately verified OpenAI-compatible transcription service.
HACKATHON_STT_BASE_URL=
HACKATHON_STT_MODEL=
HACKATHON_STT_API_KEY=
