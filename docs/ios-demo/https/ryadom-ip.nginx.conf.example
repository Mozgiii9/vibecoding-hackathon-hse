# REVIEW TEMPLATE ONLY. Not deployed or nginx-tested on the shared server.
# The integrator must verify both loopback ports and the certificate paths.
server {
    listen 80;
    server_name 77.239.111.64;
    location ^~ /.well-known/acme-challenge/ {
        root /srv/ryadom-hackathon/integration/https/acme;
        default_type text/plain;
        try_files $uri =404;
    }
    location / { return 308 https://77.239.111.64$request_uri; }
}
server {
    listen 443 ssl;
    server_name 77.239.111.64;
    ssl_certificate /etc/letsencrypt/live/77.239.111.64/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/77.239.111.64/privkey.pem;
    ssl_protocols TLSv1.2 TLSv1.3;
    client_max_body_size 12m;

    # /api/auth/login -> gateway /auth/login (same rewrite as Vite).
    location /api/ {
        proxy_pass http://127.0.0.1:18789/;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-Proto https;
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_buffering off;
        proxy_read_timeout 180s;
    }
    location / {
        proxy_pass http://127.0.0.1:17073;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-Proto https;
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_set_header X-Real-IP $remote_addr;
    }
}
