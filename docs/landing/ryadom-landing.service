[Unit]
Description=Ryadom standalone static landing
After=network.target

[Service]
Type=simple
DynamicUser=yes
WorkingDirectory=/srv/ryadom-hackathon/landing/current
ExecStart=/srv/ryadom-hackathon/landing/tools/node /srv/ryadom-hackathon/landing/current/server.mjs
Environment=HOST=0.0.0.0
Environment=PORT=80
Restart=on-failure
RestartSec=3
AmbientCapabilities=CAP_NET_BIND_SERVICE
CapabilityBoundingSet=CAP_NET_BIND_SERVICE
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
RestrictSUIDSGID=yes
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX

[Install]
WantedBy=multi-user.target
